# syntax=docker/dockerfile:1
FROM rust:1.80.0-slim-bullseye AS builder

WORKDIR /workspace

# Install required build utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Add deterministic wasm target
RUN rustup target add wasm32-unknown-unknown

# Install pinned soroban-cli
RUN cargo install --locked --version 21.4.0 soroban-cli

# Copy source tree
COPY contracts/ ./contracts/
COPY scripts/ ./scripts/

WORKDIR /workspace/contracts

# Set deterministic rustflags (strips local path prefixes and symbols)
ENV RUSTFLAGS="--remap-path-prefix=/workspace=/build -C debuginfo=0"

# Build all contract artifacts in release mode
RUN cargo build --target wasm32-unknown-unknown --release

# Output verification stage
FROM debian:bullseye-slim AS verifier
WORKDIR /artifacts
COPY --from=builder /workspace/contracts/target/wasm32-unknown-unknown/release/nbbs_*.wasm ./
COPY contracts/checksums.sha256 ./

# Checksum verification
RUN sha256sum nbbs_*.wasm
CMD ["sha256sum", "-c", "checksums.sha256"]

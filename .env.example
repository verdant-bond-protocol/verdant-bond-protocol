# ── Stellar Network ──────────────────────────────────────────────
STELLAR_NETWORK=testnet                        # testnet | mainnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PUBLIC_KEY=G...                        # Admin public key (used by deploy scripts)

# ── Signer Keys (used by the API to build transactions) ──────────
# SIGNING_KEY_PROVIDER=env                      # env | file (file is dev/test only; use KMS/HSM in production)
# SIGNING_KEY_FILE=./secrets/signing-keys.json  # JSON file for SIGNING_KEY_PROVIDER=file
ADMIN_SECRET_KEY=S...                          # Issuer/admin secret key
USER_SECRET_KEY=S...                           # Regular user (developer) secret key
INVESTOR_SECRET_KEY=S...                       # Investor secret key

# ── Contract Addresses (populated after deployment) ──────────────
# These must match deployed contract addresses on the selected network.
# Obtain them from contract deployment outputs or the contract registry.
GOVERNANCE_ADDRESS=C...
BOND_ISSUER_ADDRESS=C...
COUPON_ENGINE_ADDRESS=C...
ORACLE_CONSUMER_ADDRESS=C...
DEX_ROUTER_ADDRESS=C...
PROJECT_REGISTRY_ADDRESS=C...
CREDIT_RETIREMENT_ADDRESS=C...

# ── IPFS / Pinata ────────────────────────────────────────────────
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=your_pinata_api_key
IPFS_SECRET_KEY=your_pinata_secret_key
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Oracle ───────────────────────────────────────────────────────
# Whitelisted provider addresses allowed to submit reports
ORACLE_PROVIDER_WHITELIST=G...                 # Comma-separated list of provider addresses
DEFAULT_PROVIDER_ADDRESS=G...                  # Default provider used by the scheduler

# Upstream endpoints polled by the standalone oracle adapters (oracle/)
VERRA_REGISTRY_URL=https://registry.verra.org/api/v1
SATELLITE_API_URL=https://api.satellite-processor.io/v1
IOT_API_URL=https://api.iot-sensor-network.io/v1

# ── Credit valuations (#204) ─────────────────────────────────────
# JSON array of price feeds. Each feed answers GET <url>?creditType=<type> with
# {"price": <number>, "currency": "USD", "observedAt": "<ISO-8601>"}.
CREDIT_PRICE_FEEDS=[]
VALUATION_CURRENCY=USD
# Optional per-credit-type overrides of freshness/outlier rules, e.g.
# {"Biodiversity":{"maxAgeSeconds":5184000,"tolerance":0.4}}
CREDIT_VALUATION_POLICY={}

# ── Authentication ───────────────────────────────────────────────
# JWT_SECRET and JWT_REFRESH_SECRET are REQUIRED in non-test environments.
# Minimum 32 characters each; must NOT contain weak phrases like "dev-secret",
# "secret", "password", "changeme", or "123456". Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_very_long_jwt_secret_here_at_least_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_very_long_refresh_jwt_secret_here_32_plus
JWT_REFRESH_EXPIRY=7d
KYC_PROVIDER_URL=https://kyc.your-provider.com
KYC_API_KEY=your_kyc_api_key

# ── Support evidence bundles (#351) ──────────────────────────────
# HMAC pepper for redacted audit evidence (>=32 chars, required in production).
AUDIT_EVIDENCE_PEPPER=
AUDIT_EVIDENCE_PEPPER_ID=v1

# ── Maintainer intent receipts ───────────────────────────────────
# Stellar secret seed (S…) used to countersign intent receipts for high-impact
# admin actions. Must differ from ADMIN_SECRET_KEY. Unset → ephemeral key per
# process (receipts stop verifying after a restart). See docs/maintainer-intent-receipts.md.
INTENT_RECEIPT_SIGNING_SECRET=
# An `authorized` receipt older than this (ms) is reported stale / outcome unknown.
INTENT_RECEIPT_STALE_MS=900000

# ── Background queue backpressure (#391) ─────────────────────────
# Defaults are safe; see docs/queue-backpressure.md. `off` is the rollback switch.
# JOB_QUEUE_BACKPRESSURE=on
# JOB_QUEUE_MAX_DEPTH=1000
# JOB_QUEUE_ADMIN_RESERVE=50
# JOB_QUEUE_MAX_DEPTH_DATA_EXPORT=100
# JOB_QUEUE_USER_MAX_DEPTH_DATA_EXPORT=3

# ── External evidence verification (#393) ────────────────────────
# legacy (default) | ed25519 | required — see docs/evidence-verification.md
# ORACLE_EVIDENCE_SIGNATURE_MODE=legacy
# ORACLE_EVIDENCE_DELEGATED_SIGNERS={"G<provider>":["G<signer>"]}
# ORACLE_EVIDENCE_MAX_AGE_SECONDS=
# ORACLE_EVIDENCE_VERIFY_CONTENT=false
# ORACLE_EVIDENCE_FETCH_ATTEMPTS=3
# ORACLE_EVIDENCE_MAX_BYTES=10485760

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/verdant_bond
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
